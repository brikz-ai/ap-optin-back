ENVIRONMENT=development
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# JWT do IdP corporativo (API interna)
# Chaves aceitas pelo shared/jwt_auth.py (ver docstring do módulo):
# - IAM_JWT_PUBLIC_KEY_BRIKZ_IAM: chave pública do IAM real (brikz-ai/backend,
#   services/iam). PEM numa linha só, com 
 literais.
# - IAM_JWT_PUBLIC_KEYS (opcional): várias PEM concatenadas, para a rotação
#   da chave do IAM.
# - IAM_JWT_PUBLIC_KEY: apesar do nome, é a chave LOCAL de homolog
#   (scripts/gerar_chaves_jwt.py + gerar_jwt.py do ap-optin-back). Só é aceita
#   com IAM_JWT_ACEITAR_CHAVE_HOMOLOG=true e ENVIRONMENT != production.
IAM_JWT_PUBLIC_KEY_BRIKZ_IAM=
IAM_JWT_PUBLIC_KEYS=
IAM_JWT_PUBLIC_KEY=
# Dev local com token de gerar_jwt.py: true. Nunca true em deploy que atende
# usuário real.
IAM_JWT_ACEITAR_CHAVE_HOMOLOG=false
IAM_JWT_ISSUER=brikz-iam
# Keycloak (realm ap): com KEYCLOAK_AP_ISSUER preenchida, aceita também os
# tokens do ap-front logado no Keycloak (aud precisa conter KEYCLOAK_AP_AUDIENCE).
# Vazia = só o IAM. As chaves vêm da JWKS do realm (precisa de rede).
KEYCLOAK_AP_ISSUER=https://auth.brikz.ai/realms/ap
KEYCLOAK_AP_AUDIENCE=ap-console

# Multi-tenancy — ver docs/superpowers/specs/2026-09-02-database-multitenant-migrations-design.md §2.
# TENANT_IDS: lista explícita de financiadores (CNPJ), separados por vírgula. É a única
# fonte de enumeração (migrate_tenants, provisionar_tenant).
TENANT_IDS=12345678000199
# Um JSON por tenant. Dev local: "database_url" (Postgres local, banco SEMPRE ap_<cnpj>).
# Homolog/prod: chaves cloudsql_* (Cloud SQL Connector) no lugar de database_url.
TENANT_12345678000199_CONFIG={"database_url":"postgresql+pg8000://optin_app:optin@localhost:5432/ap_12345678000199","cerc_client_id":"","cerc_client_secret":"","cerc_cnpj_solicitante":"12345678000199"}
# Conexão administrativa (só provisionar_tenant, para CREATE DATABASE). Aponta para o banco "postgres".
ADMIN_DB_CONFIG={"database_url":"postgresql+pg8000://optin_app:optin@localhost:5432/postgres"}

# CERC (homologação) — ver docs/superpowers/specs/2026-08-18-optin-service-design.md §5
CERC_AUTH_URL=https://api.int.cerc.com/oauth/token
CERC_API_BASE_URL=https://ap-homolog.cerc.inf.br

# CORS — origens da SPA (ap-front) autorizadas a chamar esta API.
# Dev local: http://localhost:5173 (porta padrão do Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173
